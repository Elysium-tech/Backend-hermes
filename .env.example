# =============================================================================
# Backend — Environment Variables
# Copie este arquivo para .env e preencha os valores
# =============================================================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# =============================================================================
# Database — Neon Postgres (vai substituir o SQLite local)
# =============================================================================
# 1. Crie um projeto em https://console.neon.tech (plano Free).
# 2. No dashboard: Connect -> copie a string POOLED (termina com
#    -pooler... ou usa o host com "pooler") e a string DIRECT.
# 3. Cole abaixo (SEM aspas extras) e NUNCA commite o .env real.
#
# POOLED (app em runtime: pgBouncer, aguenta muitas conexoes curtas):
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>.neon.tech/<dbname>?sslmode=require"
# DIRECT (migrations, pg_dump: conexao 1:1 sem pooler):
DIRECT_URL="postgresql://<user>:<password>@<direct-host>.neon.tech/<dbname>?sslmode=require"
#
# Branching: crie um branch por ambiente (dev/staging) ou por PR de
# preview; cada branch tem suas proprias URLs pooled/direct.
# SQLite local (legado, Fase 0): DATABASE_URL="file:./dev.db" sem DIRECT_URL.

# Auth
JWT_SECRET=change_me_to_a_strong_secret
SALT_ROUNDS=10

# Logging
LOG_PRETTY=true
# fatal | error | warn | info | debug | trace
# debug mostra a resposta crua do provedor de e-mail (útil p/ "não chegou")
LOG_LEVEL=info

# =============================================================================
# E-mail / recuperação de senha (OTP de 6 dígitos)
# =============================================================================
# Provider: console (dev: imprime no log, não envia) | smtp | resend
# Para trocar de provedor depois, basta mudar estas variáveis — nenhum código
# da aplicação conhece o provedor.
EMAIL_PROVIDER=console
MAIL_FROM="Elysium <no-reply@seudominio.com>"

# --- EMAIL_PROVIDER=smtp (genérico: Mailjet, Brevo, SMTP2GO, Gmail, SES) ---
# Mailjet: host in-v3.mailjet.com   | porta 587 | user = API Key | pass = Secret Key
# Brevo:   host smtp-relay.brevo.com| porta 587 | user = login     | pass = SMTP key
# SMTP2GO: host mail.smtp2go.com    | porta 2525
# Gmail:   host smtp.gmail.com      | porta 587  | pass = app password (2FA ativo)
SMTP_HOST=
SMTP_PORT=587
# true somente para porta 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- EMAIL_PROVIDER=resend ---
RESEND_API_KEY=

# --- Regras do OTP ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Pepper do hash do código. Se vazio, usa JWT_SECRET.
# OTP_SECRET=

# Realtime (opcional; sem ele o Socket.IO roda single-instance)
# REDIS_URL=redis://localhost:6379
